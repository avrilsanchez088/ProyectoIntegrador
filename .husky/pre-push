#!/usr/bin/env sh
# Pre-push hook — typecheck del workspace antes de subir.
#
# Más caro que pre-commit (~10-30s) pero atrapa bugs de tipos antes de
# llegar al CI. Skipear con `git push --no-verify` o `SKIP_HOOKS=1 git push`.

if [ -n "$SKIP_HOOKS" ]; then
  echo "↪︎ pre-push skipped (SKIP_HOOKS=1)"
  exit 0
fi

echo "🔍 Running typecheck (skip with SKIP_HOOKS=1)…"
pnpm typecheck
