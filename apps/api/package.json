    "@impacto/pricing": "workspace:*",
    "@impacto/shared": "workspace:*",
    "better-auth": "^1.1.0",
    "bullmq": "^5.21.0",
    "hono": "^4.6.0",
    "ioredis": "^5.4.1",
    "nodemailer": "^8.0.7",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^8.0.0",
